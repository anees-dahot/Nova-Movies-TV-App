<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- Fixed backdrop that follows focus; darkened with a colour filter, not extra layers -->
    <ImageView android:id="@+id/backdrop"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <View android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/scrim"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rows"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:clipToPadding="true" android:paddingBottom="0dp"
        android:descendantFocusability="afterDescendants"/>

    <!-- Focused-item details while browsing rows (rows sit below it, Apple TV style) -->
    <LinearLayout android:id="@+id/info_panel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="56dp" android:paddingEnd="56dp" android:paddingTop="44dp"
        android:alpha="0" android:visibility="invisible"
        android:focusable="false" android:clickable="false">
        <TextView android:id="@+id/info_kind"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/nova_white70" android:textSize="11sp"
            android:letterSpacing="0.12" android:fontFamily="sans-serif-medium"/>
        <TextView android:id="@+id/info_title"
            android:layout_width="620dp" android:layout_height="wrap_content" android:layout_marginTop="2dp"
            android:textColor="@color/nova_white" android:textSize="34sp" android:fontFamily="sans-serif-medium"
            android:maxLines="1" android:ellipsize="end" android:letterSpacing="-0.01"/>
        <TextView android:id="@+id/info_meta"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:textColor="@color/nova_white70" android:textSize="13sp"/>
        <TextView android:id="@+id/info_overview"
            android:layout_width="560dp" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textColor="@color/nova_white70" android:textSize="13sp" android:lineSpacingMultiplier="1.2"
            android:maxLines="3" android:ellipsize="end"/>
    </LinearLayout>
</FrameLayout>
