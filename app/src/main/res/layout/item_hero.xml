<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="bottom" android:clipChildren="false" android:clipToPadding="false"
    android:paddingStart="56dp" android:paddingEnd="56dp" android:paddingTop="80dp" android:paddingBottom="20dp">

    <TextView android:id="@+id/hero_kind"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/nova_white70" android:textSize="12sp"
        android:letterSpacing="0.12" android:fontFamily="sans-serif-medium"/>

    <TextView android:id="@+id/hero_title"
        android:layout_width="640dp" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/nova_white" android:textSize="46sp"
        android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end"
        android:letterSpacing="-0.02" android:lineSpacingMultiplier="0.95"/>

    <TextView android:id="@+id/hero_meta"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/nova_white70" android:textSize="14sp" android:layout_marginTop="8dp"/>

    <TextView android:id="@+id/hero_overview"
        android:layout_width="560dp" android:layout_height="wrap_content"
        android:textColor="@color/nova_white70" android:textSize="14sp"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginTop="10dp" android:maxLines="3" android:ellipsize="end"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="20dp" android:clipChildren="false" android:clipToPadding="false">
        <Button android:id="@+id/btn_play"
            android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="140dp"
            android:text="▶  Play" android:textAllCaps="false" android:textColor="@color/btn_overlay_text"
            android:background="@drawable/btn_overlay" android:fontFamily="sans-serif-medium"
            android:paddingStart="26dp" android:paddingEnd="26dp" android:textSize="15sp"
            android:stateListAnimator="@animator/card_focus"/>
        <Button android:id="@+id/btn_info"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_marginStart="12dp" android:text="More Info"
            android:textAllCaps="false" android:textColor="@color/btn_overlay_text"
            android:background="@drawable/btn_overlay"
            android:paddingStart="22dp" android:paddingEnd="22dp" android:textSize="15sp"
            android:stateListAnimator="@animator/card_focus"/>
        <Button android:id="@+id/btn_watchlist"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_marginStart="12dp" android:text="+"
            android:textAllCaps="false" android:textColor="@color/btn_overlay_text"
            android:background="@drawable/btn_overlay" android:minWidth="44dp"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:textSize="18sp"
            android:stateListAnimator="@animator/card_focus"/>
    </LinearLayout>
</LinearLayout>
