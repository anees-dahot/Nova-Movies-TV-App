<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="236dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:layout_marginEnd="16dp"
    android:focusable="true" android:defaultFocusHighlightEnabled="false" android:focusableInTouchMode="true">

    <FrameLayout android:id="@+id/card_frame"
        android:layout_width="match_parent" android:layout_height="133dp"
        android:background="@drawable/skeleton">
        <ImageView android:id="@+id/card_poster"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <TextView android:id="@+id/card_badge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="6dp"
            android:background="@drawable/badge_pill"
            android:textSize="8sp" android:textColor="@color/nova_white"
            android:fontFamily="sans-serif-medium" android:letterSpacing="0.08"
            android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
        <TextView android:id="@+id/card_lang"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:layout_margin="6dp"
            android:background="@drawable/badge_pill"
            android:textSize="8sp" android:textColor="#E6FFFFFF"
            android:fontFamily="sans-serif-medium" android:letterSpacing="0.04"
            android:paddingStart="6dp" android:paddingEnd="6dp" android:paddingTop="2dp" android:paddingBottom="2dp"/>
        <ProgressBar android:id="@+id/card_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent" android:layout_height="4dp"
            android:layout_gravity="bottom" android:layout_margin="8dp"
            android:max="1000" android:progressDrawable="@drawable/progress_track" android:visibility="gone"/>
    </FrameLayout>

    <TextView android:id="@+id/card_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/nova_white" android:textSize="12sp"
        android:maxLines="1" android:ellipsize="end" android:layout_marginTop="8dp"/>
    <TextView android:id="@+id/card_meta"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/nova_white40" android:textSize="10sp" android:maxLines="1"/>
</LinearLayout>
